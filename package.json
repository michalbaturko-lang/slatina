{
  "name": "slatina",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r run dev",
    "dev:web": "pnpm --filter @slatina/web dev",
    "dev:api": "pnpm --filter @slatina/api dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "type-check": "pnpm -r run type-check",
    "clean": "pnpm -r exec rm -rf node_modules dist .next .turbo",
    "db:migrate": "pnpm --filter @slatina/api db:migrate",
    "db:generate": "pnpm --filter @slatina/api db:generate"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
